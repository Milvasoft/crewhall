{
  "name": "@crewhall/backend",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "dev:collab": "tsx watch --env-file-if-exists=.env src/collab/index.ts",
    "start": "node --import ./dist/otel.js dist/index.js",
    "start:worker": "node --import ./dist/otel.js dist/worker.js",
    "start:collab": "node --import ./dist/otel.js dist/collab.js",
    "build": "tsup",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "seed:wiki": "tsx --env-file-if-exists=.env src/scripts/seed-wiki.ts",
    "totp": "tsx src/scripts/totp.ts",
    "mail:timing": "tsx src/scripts/mail-timing.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:ai": "vitest run test/ai-eval.test.ts --silent=false",
    "accept:phase1": "tsx src/scripts/accept-phase1.ts",
    "accept:stack": "tsx src/scripts/accept-stack.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/expo": "1.7.11",
    "@better-auth/passkey": "1.7.11",
    "@better-auth/utils": "0.5.0",
    "@crewhall/db": "workspace:*",
    "@crewhall/editor": "workspace:*",
    "@crewhall/i18n": "workspace:*",
    "@crewhall/plugin-sdk": "workspace:*",
    "@crewhall/shared": "workspace:*",
    "@ewsjs/xhr": "3.1.3",
    "@hocuspocus/extension-database": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "^1.0.11",
    "@node-saml/node-saml": "5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@simplewebauthn/server": "13.3.3",
    "better-auth": "1.7.11",
    "docx": "^9.13.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "file-type": "^22.2.0",
    "hono": "^4.13.13",
    "imapflow": "2.8.0",
    "import-in-the-middle": "^3.5.2",
    "jose": "6.2.12",
    "katex": "^0.19.1",
    "ldapts": "9.2.0",
    "livekit-server-sdk": "^2.19.1",
    "mailparser": "3.12.1",
    "nodemailer": "^10.1.7",
    "openid-client": "6.8.8",
    "pdfjs-dist": "^6.4.299",
    "pdfmake": "^0.3.12",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "sanitize-html": "2.18.1",
    "sharp": "^0.35.5",
    "uuidv7": "^1.2.1",
    "v9u-smb2": "1.0.6",
    "ws": "^8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@crewhall/api-client": "workspace:*",
    "@crewhall/config": "workspace:*",
    "@crewhall/crypto": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@hocuspocus/provider": "4.7.1",
    "@livekit/rtc-node": "^1.1.0",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/mailparser": "3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "webdav": "^5.11.0"
  }
}
