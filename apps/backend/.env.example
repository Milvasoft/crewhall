# Local development (copy to apps/backend/.env). Infra: docker compose -f docker/compose.dev.yml up -d
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Web dev server (Vite) and this api
HUB_URL=http://localhost:5173
API_URL=http://localhost:3000
# Federation (roadmap 26): allow plain http between local instances (development only).
FEDERATION_ALLOW_HTTP=false
# Plugins: the central marketplace and its public key(s) as keyId:base64-spki,...
MARKETPLACE_URL=https://market.crewhall.dev
MARKETPLACE_PUBLIC_KEYS=
# Shared channels: invites from these peer domains are accepted at once (demo/test servers).
FEDERATION_AUTO_ACCEPT_DOMAINS=
# More browser origins for CORS/better-auth, comma separated (e.g. a second web port)
WEB_ORIGINS=
# Mobile: expo scheme and Expo Go
TRUSTED_ORIGINS=crewhall://,exp://

# Postgres from compose.dev.yml (host port 5433)
DATABASE_URL=postgres://crewhall:crewhall@localhost:5433/crewhall
MIGRATE_ON_START=true
# Run the job worker (uploads processing, previews, link checks) inside the api in development
WORKER_IN_PROCESS=true

# 32+ characters. Dev only; generate a real one for any shared server.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Leave empty in dev to run the setup wizard without a token.
SETUP_TOKEN=
SIGNUP_OPEN=false
TOTP_ISSUER=Crewhall

# Mailpit catches everything: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Crewhall <hub@crewhall.local>

# SeaweedFS from compose.dev.yml
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=crewhall
S3_ACCESS_KEY=crewhall
S3_SECRET_KEY=crewhall-dev-secret

# Shown in bootstrap.server. Empty APP_VERSION = package.json; empty MIN_MOBILE_VERSION = no limit.
APP_VERSION=
MIN_MOBILE_VERSION=
# Set by CI at image build (Dockerfile build args); getCompat reports them. Empty: not reported.
BUILD_ID=
BUILD_COMMIT=
# Oldest app versions accepted (older apps get 426 client_outdated); empty iOS/Android = MIN_MOBILE_VERSION.
MIN_CLIENT_IOS=
MIN_CLIENT_ANDROID=
MIN_CLIENT_DESKTOP=
# Store or download page an outdated app is sent to (optional).
CLIENT_STORE_URL_IOS=
CLIENT_STORE_URL_ANDROID=
CLIENT_STORE_URL_DESKTOP=
# Requests for addresses people type (link titles/health, automation webhooks, federation) never reach
# private, loopback or metadata addresses. Intranet exceptions: CIDRs, hosts or *.corp.example (any port).
PRIVATE_FETCH_ALLOWLIST=
# Ports besides 80/443 those requests may use on public addresses, comma list
OUTBOUND_ALLOWED_PORTS=

# Expo push (chat notifications). Token only when enhanced push security is on.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push
# GIFs in chat: each org enters its own GIPHY key in the admin; only the API address is here.
GIPHY_API_URL=https://api.giphy.com
EXPO_ACCESS_TOKEN=

# Firebase Cloud Messaging (HTTP v1) for native FCM tokens: path to the service account JSON
# (keep it outside the repo), or the JSON itself in FIREBASE_SERVICE_ACCOUNT_JSON. Empty = no FCM.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

# iOS incoming calls through CallKit: VoIP pushes straight to APNs with the .p8 key (Apple
# Developer > Keys). APNS_KEY_PATH to the file (keep it outside the repo) or APNS_KEY_P8 with its
# content; with any of them empty no VoIP push is sent. APNS_ENV: production (TestFlight, App
# Store) or sandbox (development builds).
APNS_KEY_PATH=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_ENV=production

# Optional OTLP/HTTP endpoint (e.g. Seq http://localhost:5341/ingest/otlp)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Wiki collab server (src/collab, pnpm dev:collab). Clients get COLLAB_PUBLIC_URL with their
# page token; the api calls COLLAB_INTERNAL_URL for live edits (restore, MCP).
COLLAB_PORT=3001
COLLAB_PUBLIC_URL=

# Office module: the address the document server uses to download and save files here
# (/api/office, /wopi). Empty = API_URL. Inside Docker e.g. http://backend:3000.
OFFICE_HOST_URL=
COLLAB_INTERNAL_URL=
# Portal: HMAC key of the Next.js site's /api/revalidate webhook (apps/portal has the same)
PORTAL_REVALIDATE_SECRET=dev-portal-revalidate-secret-change-me
# Meetings (LiveKit from docker/compose.dev.yml --profile meet; docs/contracts/meet-calistirma.md).
# Empty key/secret = meetings answer 503 meet_unavailable.
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=crewhall-dev
LIVEKIT_API_SECRET=crewhall-dev-livekit-secret-0123456789abcdef
# true when egress runs (profile meet-rec); it uploads to S3 at MEET_EGRESS_S3_ENDPOINT
MEET_EGRESS_ENABLED=false
MEET_EGRESS_S3_ENDPOINT=http://seaweedfs:8333
