# Hub API the site reads published content from (public content API).
HUB_API_URL=http://localhost:4201
# Read-only site token from Hub › Portal › Ayarlar › Okuma anahtarı.
PORTAL_CONTENT_TOKEN=
# Shared secret the Hub worker signs /api/revalidate calls with (HMAC-SHA256).
PORTAL_REVALIDATE_SECRET=
# Locale served without a URL prefix until the Hub answers (the Hub site setting wins).
PORTAL_DEFAULT_LOCALE=en
# Canonical base URL when the Hub site has none, e.g. https://portal.example.com
PORTAL_PUBLIC_URL=
