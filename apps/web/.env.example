# Backend origin. Leave empty to call the same origin (/api via the Vite dev proxy or Caddy).
VITE_API_URL=
# Dev-only proxy target when VITE_API_URL is empty (apps/backend listens on 3000).
VITE_API_PROXY=http://localhost:3000
# Dev-only proxy target for /collab (Hocuspocus, prefix stripped like Caddy). For phones and the LAN
# set the backend's COLLAB_PUBLIC_URL=ws://<host>:<web port>/collab.
VITE_COLLAB_PROXY=http://localhost:3001
# 1 = run against the in-browser MSW mock of the /api/v1 contract and better-auth (no backend needed).
# `pnpm --filter @crewhall/web dev:mock` sets it for you.
VITE_API_MOCK=0
# Dev-only proxy target for /livekit (LiveKit signalling). An https page cannot open ws:// to
# LiveKit, so with VITE_DEV_HTTPS the room connects through wss://<this host>/livekit.
VITE_LIVEKIT_PROXY=http://localhost:7880
# 1 = serve the dev server over https (self-signed). Needed for camera and microphone when the app
# is opened by LAN address from another device; add that origin to the backend's WEB_ORIGINS.
VITE_DEV_HTTPS=0
