{
  "name": "@crewhall/desktop",
  "productName": "Crewhall",
  "version": "0.2.14",
  "private": true,
  "description": "Crewhall desktop app for Windows and macOS",
  "author": "Crewhall",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "node scripts/build-native.mjs && node scripts/build.mjs && electron-builder --config electron-builder.config.cjs --win nsis --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "publish:updates": "node scripts/publish-updates.mjs"
  },
  "devDependencies": {
    "@crewhall/api-client": "workspace:*",
    "@crewhall/config": "workspace:*",
    "@crewhall/i18n": "workspace:*",
    "@crewhall/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@jitsi/robotjs": "0.6.24",
    "@types/node": "^22.20.5",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "intl-messageformat": "^12.1.3",
    "lottie-web": "5.13.0",
    "node-addon-api": "8.9.2",
    "node-gyp": "12.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "zod": "^4.1.0"
  }
}
