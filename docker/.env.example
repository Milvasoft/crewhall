# Production compose variables (docker/compose.yml). Copy to docker/.env and fill in.
#
# Development uses docker/compose.dev.yml instead and needs no .env: it publishes Postgres on
# host port 5433 (not 5432, which a locally installed Postgres often holds), S3 on 8333 and
# Mailpit on 1025/8025. Override with POSTGRES_PORT=... and update DATABASE_URL to match;
# apps/backend/.env.example already points at localhost:5433.
# Generate secrets with: openssl rand -base64 32

# Domains (design doc 17 §15 #13: hub. and s3. subdomains)
HUB_DOMAIN=hub.example.com
S3_DOMAIN=s3.example.com
ACME_EMAIL=it@example.com

# Optional: other host ports for Caddy, and the public URLs when they are not https://<domain>
# (e.g. behind another proxy or on :8443). Leave commented for the usual 80/443 setup.
# HTTP_PORT=80
# HTTPS_PORT=443
# HUB_URL=https://hub.example.com:8443
# S3_PUBLIC_URL=https://s3.example.com:8443
# COLLAB_PUBLIC_URL=wss://hub.example.com:8443/collab
# PORTAL_PUBLIC_URL=https://docs.example.com:8443

# Image source
CREWHALL_REGISTRY=crewhall
CREWHALL_VERSION=latest

# Postgres
POSTGRES_USER=crewhall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crewhall

# Auth: 32+ random bytes. Changing it invalidates sessions and stored 2FA secrets.
AUTH_SECRET=change-me-to-32-random-bytes-base64
# Optional fixed setup token; when empty a random one is generated and printed in the logs.
SETUP_TOKEN=

# S3 (bundled SeaweedFS or any external S3)
S3_BUCKET=crewhall
S3_ACCESS_KEY=crewhall
S3_SECRET_KEY=change-me

# Mail (optional; without SMTP, invitations are shared as links)
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM=Crewhall <hub@example.com>

# Mobile app origins allowed by better-auth (expo scheme)
TRUSTED_ORIGINS=crewhall://

# Chat push through Expo (optional token for enhanced push security)
EXPO_PUSH_URL=https://exp.host/--/api/v2/push
EXPO_ACCESS_TOKEN=
# Firebase service account for FCM push, as one line: jq -c . firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# iOS incoming calls (CallKit, VoIP push to APNs). The .p8 key on one line:
# awk '{printf "%s\\\\n", $0}' AuthKey_XXXX.p8. Empty = iPhones get the ordinary push.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# production (TestFlight, App Store) or sandbox (development builds)
APNS_ENV=production

# Observability (optional): OTLP/HTTP endpoint, e.g. Seq http://seq:5341/ingest/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Oldest mobile app version this server supports (e.g. 1.0.0); empty = no limit
MIN_MOBILE_VERSION=
# Oldest app versions accepted (older apps get 426 client_outdated); empty iOS/Android = MIN_MOBILE_VERSION.
MIN_CLIENT_IOS=
MIN_CLIENT_ANDROID=
MIN_CLIENT_DESKTOP=
# Store or download page an outdated app is sent to (optional).
CLIENT_STORE_URL_IOS=
CLIENT_STORE_URL_ANDROID=
CLIENT_STORE_URL_DESKTOP=
# Requests for addresses people type (link titles/health, automation webhooks, federation) never reach
# private, loopback or metadata addresses. Intranet exceptions: CIDRs, hosts or *.corp.example (any port).
PRIVATE_FETCH_ALLOWLIST=
# Ports besides 80/443 those requests may use on public addresses, comma list
OUTBOUND_ALLOWED_PORTS=
# Desktop releases in the S3 bucket under this prefix when the image folder is empty (default desktop-updates/)
DESKTOP_UPDATES_S3_PREFIX=

# Portal site (Next.js, optional: docker compose --profile portal up -d)
PORTAL_DOMAIN=portal.example.com
# Same value for backend/worker and portal: signs the revalidate webhook.
PORTAL_REVALIDATE_SECRET=change-me-32-random-bytes
# Read-only content token from Hub › Portal › Ayarlar (shown once when rotated).
PORTAL_CONTENT_TOKEN=
PORTAL_DEFAULT_LOCALE=en
# Office documents (profile office: Euro-Office). Same value in Yönetim › Entegrasyonlar › Office.
OFFICE_DOMAIN=office.example.com
# 32+ random characters
OFFICE_JWT_SECRET=
# Meetings (profile meet: LiveKit, egress, coturn). Leave the keys empty to run without meetings.
LK_DOMAIN=lk.example.com
LIVEKIT_API_KEY=
# 32+ random characters
LIVEKIT_API_SECRET=
# true once the egress container runs (recording button)
MEET_EGRESS_ENABLED=false
# TURN (coturn) for networks without UDP; TURN_DOMAIN defaults to HUB_DOMAIN
TURN_DOMAIN=
TURN_USER=crewhall
TURN_PASSWORD=change-me
