    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-tr": "^4.1.1",
    "hash-wasm": "^4.12.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@crewhall/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "@types/node": "^22.20.5"
  }
