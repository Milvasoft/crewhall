{
  "name": "@crewhall/api-client",
  "version": "0.1.0",
  "description": "Typed client for the Crewhall REST API, generated from the same contract the server validates with",
  "keywords": [
    "crewhall",
    "api",
    "client",
    "typescript",
    "zod"
  ],
  "license": "SEE LICENSE IN ../../LICENSE",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@crewhall/config": "workspace:*",
    "@crewhall/shared": "workspace:*",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
