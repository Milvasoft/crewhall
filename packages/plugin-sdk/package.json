{
  "name": "@crewhall/plugin-sdk",
  "version": "0.1.0",
  "description": "Build plugins for Crewhall: manifest schema, package signatures, the iframe bridge, server helpers and the crewhall-plugin CLI",
  "keywords": [
    "crewhall",
    "plugin",
    "sdk"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bridge.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "plugin": "tsx src/cli.ts"
  },
  "dependencies": {
    "jose": "6.2.12",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@crewhall/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
